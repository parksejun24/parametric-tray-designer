{
  "name": "parametric-tray-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:browser": "vitest run tests/browser",
    "test:integration": "vitest run tests/integration",
    "test:properties": "vitest run tests/properties",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=./.playwright-browsers playwright test -c tests/e2e/playwright.config.ts",
    "test:algorithm-viability": "vitest run tests/algorithm-viability",
    "test:independent-dxf": "vitest run tests/independent-dxf",
    "test:fixtures": "vitest run tests/fixtures",
    "benchmark": "vitest bench --run tests/performance"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-18",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/node": "24.5.2",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
